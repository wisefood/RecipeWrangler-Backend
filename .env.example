# RecipeWrangler Backend — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=secret

# ── Search LLM ────────────────────────────────────────────────────────────────
# Supported values: openrouter, groq.
SEARCH_LLM_SOURCE=openrouter
SEARCH_MAIN_MODEL=openai/gpt-oss-20b
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required instead when SEARCH_LLM_SOURCE=groq:
# GROQ_API_KEY=gsk-...
# GUARDRAILS_MODEL=llama-3.1-8b-instant
# SEARCH_TEMPERATURE=0.0

# ── Parser/weight LLM provider ────────────────────────────────────────────────
# Supported values: groq, openrouter, vllm. Defaults to Groq.
# WEIGHT_LLM_SOURCE=openrouter
# PARSE_LLM=openai/gpt-4o-mini
# WEIGHT_LLM=openai/gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# For a local OpenAI-compatible vLLM server:
# VLLM_BASE_URL=http://localhost:8007/v1
# VLLM_API_KEY=none

# ── Elasticsearch ──────────────────────────────────────────────────────────────
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=recipes_v2
# ELASTIC_TIMEOUT=3.0
# Ingredient vector lookup index.
ELASTIC_VECTOR_INDEX=ingredient_vectors
# ELASTIC_VECTOR_TIMEOUT=3.0
# Exact provides deterministic candidate scoring.
# Set to knn after recall/latency evaluation if approximate retrieval is acceptable.
ELASTIC_VECTOR_SEARCH_MODE=exact
# ELASTIC_VECTOR_CANDIDATE_MULTIPLIER=10
# Hybrid ingredient matching independently retrieves this many vector and BM25
# candidates, unions them, and applies reciprocal-rank fusion before reranking.
ELASTIC_HYBRID_POOL_SIZE=25
# ELASTIC_HYBRID_RRF_CONSTANT=60

# ── PostgreSQL (nutrition data) ────────────────────────────────────────────────
# Matches postgresql-docker/docker-compose.yaml for a host-run API.
NUTRITION_HOST=localhost
NUTRITION_PORT=5435
NUTRITION_DB=nutrients
NUTRITION_USER=postgres
NUTRITION_PASSWORD=postgres
NUTRITION_USE_DOCKER=0
NUTRITION_CONTAINER=wisefood-postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
RECIPE_CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_RECIPE_DB=7

# ── API server ─────────────────────────────────────────────────────────────────
# PORT=8001

# ── CORS (comma-separated origins; * allows all — dev only) ───────────────────
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Profiling pipeline versioning (optional) ──────────────────────────────────
# NUTRITION_PROFILE_PIPELINE_VERSION=v1
# NUTRITION_PROFILE_MAPPING_VERSION=v1
# NUTRITION_PROFILE_EMBEDDING_MODEL=default

# ── Embedding model (HuggingFace, used for all vector collections) ─────────────
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# Pin the model revision used to build/query vector indexes in production.
# EMBED_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBED_BATCH_SIZE=256
# EMBED_DEVICE=cuda   # set to cpu to force CPU inference
# NUTRITION_PROFILE_RULESET_VERSION=v1
